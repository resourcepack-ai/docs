{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resourcepackai-docs",
  // Like landing (and unlike studio) there's no Workflow or other custom
  // export to wrap, so OpenNext's generated worker is the entrypoint
  // directly — no custom-worker.ts.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "resourcepackai-docs" }
  ],
  // No D1, no R2, no secrets: the docs are static content compiled at
  // build time. If that ever changes, add the binding here AND run
  // `npm run cf:typegen`.
  //
  // One route, and it's a path route rather than a custom domain: the docs
  // live at resourcepack.ai/docs (see next.config.ts's basePath). Cloudflare
  // runs a route BEFORE a Custom Domain on the same hostname, so this
  // intercepts /docs* while landing keeps its custom domain on the apex
  // untouched — no release-then-claim handover on resourcepack.ai and no
  // window where the marketing site is unrouted. The wildcard matches both
  // /docs and /docs/anything. `zone_name` is required: a path route can't
  // infer its zone the way a custom domain does.
  //
  // There is deliberately no docs.resourcepack.ai entry. It was the old home
  // and briefly stayed on to serve a redirect, but it was retired while the
  // product was still pre-launch — nothing had linked to it yet except our
  // own server-plugin menu, which now points at the new URL. Post-launch that
  // redirect would have been worth keeping; at zero inbound links it was
  // ceremony.
  "routes": [
    { "pattern": "resourcepack.ai/docs*", "zone_name": "resourcepack.ai" }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
  // No staging environment, same reasoning as landing: nothing here is
  // auth-gated or data-touching, it ships straight to prod.
}
