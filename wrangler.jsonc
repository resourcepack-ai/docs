{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resourcepackai-docs",
  // Like landing (and unlike studio) there's no Workflow or other custom
  // export to wrap, so OpenNext's generated worker is the entrypoint
  // directly — no custom-worker.ts.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "resourcepackai-docs" }
  ],
  // No D1, no R2, no secrets: the docs are static content compiled at
  // build time. If that ever changes, add the binding here AND run
  // `npm run cf:typegen`.
  //
  // Two entries, and they do different jobs.
  //
  // The path route is where the docs actually live now (see next.config.ts's
  // basePath). Cloudflare runs a route BEFORE a Custom Domain on the same
  // hostname, so this intercepts /docs* while landing keeps its custom domain
  // on the apex untouched — no release-then-claim handover on resourcepack.ai
  // and no window where the marketing site is unrouted. The wildcard matches
  // both /docs and /docs/anything. `zone_name` is required: a path route
  // can't infer its zone the way a custom domain does.
  //
  // The custom domain is the OLD address, kept alive only so the permanent
  // redirect in next.config.ts has something to run on. Don't remove it
  // until the redirect has stopped being useful, which is years not months.
  "routes": [
    { "pattern": "resourcepack.ai/docs*", "zone_name": "resourcepack.ai" },
    { "pattern": "docs.resourcepack.ai", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
  // No staging environment, same reasoning as landing: nothing here is
  // auth-gated or data-touching, it ships straight to prod.
}
